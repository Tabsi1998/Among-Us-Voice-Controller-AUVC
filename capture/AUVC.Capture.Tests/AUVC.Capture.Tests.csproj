<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <ProjectReference Include="../AUOffsetHelper/AUOffsetHelper.csproj" />
    <ProjectReference Include="../AUOffsetManager/AUOffsetManager.csproj" />
    <ProjectReference Include="../AUVC.Protocol/AUVC.Protocol.csproj" />
    <ProjectReference Include="../AUVC.Transport/AUVC.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../Offsets.json" Link="Fixtures/Offsets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/legacy-2020.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The protocol fixtures are shared with the Go tests. Both languages
         read the same files, so a change that breaks one breaks the other. -->
    <None Include="../../protocol/fixtures/**/*.json" LinkBase="Fixtures/protocol" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
