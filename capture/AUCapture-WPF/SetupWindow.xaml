<mah:MetroWindow
    x:Class="AUCapture_WPF.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Width="580"
    Height="680"
    MinWidth="480"
    MinHeight="560"
    ResizeMode="CanResize"
    TitleCharacterCasing="Normal"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="StepTitle"
            Grid.Row="0"
            Margin="0,0,0,14"
            FontSize="20"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="TokenPanel">
                    <TextBlock x:Name="TokenIntro" TextWrapping="Wrap" />
                    <Button
                        x:Name="OpenPortalButton"
                        Margin="0,14,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Click="OpenPortalButton_Click" />
                    <PasswordBox x:Name="TokenBox" Margin="0,18,0,0" />
                    <Button
                        x:Name="CheckTokenButton"
                        Margin="0,8,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Click="CheckTokenButton_Click"
                        IsDefault="True" />
                    <TextBlock
                        x:Name="TokenResult"
                        Margin="0,10,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ServerPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ServerIntro" TextWrapping="Wrap" />
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Button
                            x:Name="InviteButton"
                            Padding="12,6"
                            Click="InviteButton_Click" />
                        <Button
                            x:Name="RefreshServersButton"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Click="RefreshServersButton_Click" />
                    </StackPanel>
                    <TextBlock
                        x:Name="BotState"
                        Margin="0,14,0,0"
                        TextWrapping="Wrap" />
                    <ListBox
                        x:Name="ServerList"
                        MinHeight="140"
                        Margin="0,8,0,0"
                        DisplayMemberPath="Name"
                        SelectionChanged="ServerList_SelectionChanged" />
                </StackPanel>

                <StackPanel x:Name="ChannelPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ChannelIntro" TextWrapping="Wrap" />
                    <TextBlock x:Name="MainChannelLabel" Margin="0,16,0,4" />
                    <ComboBox x:Name="MainChannelBox" DisplayMemberPath="Name" />
                    <TextBlock x:Name="GhostChannelLabel" Margin="0,12,0,4" />
                    <ComboBox x:Name="GhostChannelBox" DisplayMemberPath="Name" />
                    <TextBlock x:Name="ControlChannelLabel" Margin="0,12,0,4" />
                    <ComboBox x:Name="ControlChannelBox" DisplayMemberPath="Name" />
                    <CheckBox
                        x:Name="AutoStartBox"
                        Margin="0,16,0,0"
                        IsChecked="True" />
                    <Button
                        x:Name="RefreshChannelsButton"
                        Margin="0,14,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Click="RefreshChannelsButton_Click" />
                    <TextBlock
                        x:Name="ChannelResult"
                        Margin="0,10,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                    <TextBlock x:Name="DoneIntro" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ChecksHeading"
                        Margin="0,18,0,6"
                        FontWeight="SemiBold" />
                    <ItemsControl x:Name="ChecksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,2"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        x:Name="RefreshChecksButton"
                        Margin="0,10,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Click="RefreshChecksButton_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                MinWidth="100"
                Padding="12,6"
                Click="CancelButton_Click"
                IsCancel="True" />
            <Button
                x:Name="BackButton"
                MinWidth="100"
                Margin="8,0,0,0"
                Padding="12,6"
                Click="BackButton_Click" />
            <Button
                x:Name="NextButton"
                MinWidth="100"
                Margin="8,0,0,0"
                Padding="12,6"
                Click="NextButton_Click"
                Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
