<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships the offset index inside the assembly so capture can read the game
         without contacting any third-party host. -->
    <EmbeddedResource Include="../Offsets.json" LogicalName="AUOffsetManager.Offsets.json" />
  </ItemGroup>

</Project>
