<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Nullable reference types are off deliberately, not by omission:
         enabling them reports 56 warnings here today. This is offset code, which the phase 11 contract keeps unchanged and
         comparable with upstream. Annotating it is a separate, reviewable change. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships the offset index inside the assembly so capture can read the game
         without contacting any third-party host. -->
    <EmbeddedResource Include="../Offsets.json" LogicalName="AUOffsetManager.Offsets.json" />
  </ItemGroup>

</Project>
