# Copy to .env and fill in. .env is git-ignored; this file must never contain a
# real token.

# The only required setting. Create a bot at
# https://discord.com/developers/applications, copy its token here, and invite
# it with the Move Members, Mute Members, Deafen Members, View Channel and
# Connect permissions on the voice channels it will manage.
#
# Treat it like a password: anyone holding it controls the bot.
DISCORD_BOT_TOKEN=

# Where the capture app connects. The image already sets this; override it only
# to change the port.
#AUVC_CAPTURE_ADDR=:8123

# TLS. Without both of these the listener serves plain HTTP and says so on every
# start. That is fine behind a reverse proxy that terminates TLS, and not fine
# otherwise: capture credentials would travel in the clear.
#AUVC_CAPTURE_TLS_CERT=/certs/fullchain.pem
#AUVC_CAPTURE_TLS_KEY=/certs/privkey.pem

# Where the SQLite database lives inside the container. The compose file mounts
# a volume at /data; changing this without changing that loses the
# configuration on the next restart.
#AUVC_DATABASE_PATH=/data/amongus.db

# Register the /au command in these servers instead of globally, comma
# separated. A global registration can take up to an hour to appear, so this is
# what makes a change visible immediately while setting things up.
#SLASH_COMMAND_GUILD_IDS=

# What the bot shows as its activity in Discord.
#AUVC_LISTENING=/au

# Logging. AUVC writes to stdout and to LOG_PATH/logs.txt; in a container the
# file is usually redundant.
#DISABLE_LOG_FILE=1
#LOG_PATH=/app/logs

# Interface language for bot messages.
#BOT_LANG=en
