* text=auto
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf
# Read by Docker Compose on Linux, so it keeps Unix line endings even when
# it is edited on Windows.
deploy/.env.example text eol=lf
/LICENSE text eol=lf
/.editorconfig text eol=lf
/.gitattributes text eol=lf
/.gitignore text eol=lf
/.dockerignore text eol=lf
deploy/Dockerfile* text eol=lf
# Keep upstream blobs and copied notices byte-for-byte; do not renormalize.
bot/** -text
capture/** -text
LICENSES/** -text
# New baseline files use stable line endings; original upstream blobs stay intact.
capture/**/packages.lock.json text eol=lf
capture/AUVC.Capture.Tests/** text eol=lf
