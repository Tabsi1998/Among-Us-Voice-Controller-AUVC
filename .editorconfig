root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.go]
indent_style = tab

# Imported files keep their existing formatting until a separate reviewed change.
[{bot,capture}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Phase 2 adopts deterministic formatting for active source files.
[bot/**/*.go]
end_of_line = lf
indent_style = tab

[capture/**/*.cs]
end_of_line = lf
indent_style = space
indent_size = 4
